# supabase = hosted persistence. mock = local in-memory demo data.
# live remains available for the legacy standalone API adapter.
VITE_API_MODE=supabase

# Browser-safe Supabase credentials used by Auth and the Supabase API adapter.
# Never put a secret/service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Launch week: the ISO instant the board goes live. While it is in the future the home page shows the sealed
# state with a countdown; unset or past means the ordinary page. Production sets it in the Vercel project.
# VITE_REVEAL_AT=2026-09-11T16:00:00Z
# Mock mode only: start with the seed's users but no rigs or results, as on launch morning.
# VITE_MOCK_EMPTY=true
